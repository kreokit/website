---
import { existsSync } from "node:fs";
import Base from "../layouts/Base.astro";
import Downloads from "../components/Downloads.astro";
import StarIcon from "../components/StarIcon.astro";
import { apps } from "../lib/apps.mjs";
import { repoUrl } from "../lib/links.mjs";

export function getStaticPaths() {
  return apps.map((app) => ({ params: { app: app.slug }, props: { app } }));
}

const { app } = Astro.props;

// Drop public/screenshots/<app>.png (or .jpg / .webp) in to replace the placeholder.
const shot = ["png", "jpg", "webp"]
  .map((ext) => `screenshots/${app.slug}.${ext}`)
  .find((file) => existsSync(`public/${file}`));
---

<Base title={app.title} description={app.description}>
  <nav class="crumbs" aria-label="Breadcrumb">
    <a href="/">KreoKit</a> <span aria-hidden="true">›</span> <span aria-current="page">{app.name}</span>
  </nav>
  <div class="app-top">
    <div class="app-intro">
      <p class="eyebrow">{app.fullName}</p>
      <h1>{app.h1}</h1>
      <p class="lead">{app.short}</p>
      <div class="what">
        {app.what.map((p) => <p>{p}</p>)}
      </div>
    </div>
    <Downloads app={app} />
  </div>

  <section class="section" aria-label="Screenshot">
    {shot ? (
      <div class="shot">
        <img src={`/${shot}`} alt={`The ${app.fullName} window: ${app.short}`} loading="lazy" />
      </div>
    ) : (
      <div class="shot shot-empty">Screenshot coming soon</div>
    )}
  </section>

  <section class="section" aria-labelledby="who-title">
    <h2 id="who-title">Who it's for</h2>
    <p class="prose">{app.who}</p>
  </section>

  <section class="section" aria-labelledby="what-title">
    <h2 id="what-title">What it does</h2>
    <div class="features">
      {app.features.map(([title, text]) => (
        <div>
          <h3>{title}</h3>
          <p>{text}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section" aria-labelledby="how-title">
    <h2 id="how-title">How it works</h2>
    <ol class="steps">
      {app.steps.map(([title, text]) => (
        <li>
          <h3>{title}</h3>
          <p>{text}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="section" aria-labelledby="req-title">
    <h2 id="req-title">System requirements</h2>
    <ul class="reqs">
      {app.requirements.map((r) => <li>{r}</li>)}
    </ul>
    <p class="muted small" style="margin-top: 12px">
      The alpha isn't signed yet, so your computer warns you the first time: <a href="/install">here's how to install and open it</a>.
    </p>
  </section>

  <section class="section" aria-labelledby="privacy-title">
    <h2 id="privacy-title">Private and offline</h2>
    <p class="prose">{app.privacy}</p>
  </section>

  <section class="section" aria-labelledby="faq-title">
    <h2 id="faq-title">Frequently asked questions</h2>
    <div class="faq">
      {app.faq.map(([q, a]) => (
        <div>
          <h3>{q}</h3>
          <p>{a}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section" aria-labelledby="more-title">
    <h2 id="more-title">More free KreoKit apps</h2>
    <div class="cards cards-small">
      {apps.filter((other) => other.slug !== app.slug).map((other) => (
        <a class="card" href={`/${other.slug}`}>
          <h3>{other.fullName}</h3>
          <p>{other.short}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="section panel star-box" aria-labelledby="star-title">
    <div>
      <h2 id="star-title">Like {app.fullName}?</h2>
      <p class="muted">A star on GitHub helps other creators find it. Found a problem? <a href={`${repoUrl(app)}/issues/new/choose`}>Report it here</a>.</p>
    </div>
    <a class="btn btn-big" href={repoUrl(app)}><StarIcon /> Star on GitHub</a>
  </section>
</Base>
